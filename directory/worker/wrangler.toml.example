# Copy to wrangler.toml (gitignored) and fill in the owner values.
# Steps: directory/README.md. Nothing here is a secret.
name = "retailops-directory"
main = "src/index.js"
compatibility_date = "2026-10-01"
# account_id = "<your Cloudflare account id>"   # or set CLOUDFLARE_ACCOUNT_ID
workers_dev = false

# The directory host. Replace retailops.invalid with the real platform domain.
routes = [
  { pattern = "directory.retailops.invalid", custom_domain = true },
]

# Optional: Cloudflare's Workers rate-limit binding (shared across isolates;
# periods of 10 or 60 seconds only). The per-hour window is enforced in the
# Worker per isolate and by a Cloudflare rate-limit rule (README step 6).
# Check the current syntax at https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
[[ratelimits]]
name = "DIRECTORY_RATE_LIMITER"
namespace_id = "1001"
  [ratelimits.simple]
  limit = 10
  period = 60

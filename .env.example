# StoreOps - one store's settings for docker-compose.yml.
#
#   cp .env.example .env && chmod 600 .env
#
# Never commit .env. Secrets stay blank here. Every app setting is listed,
# with its default, in backend/.env.example; copy any line you need from
# there into .env. The database and upload paths are set by
# docker-compose.yml (the store's volume) and are not read from this file.

# --- Compose -----------------------------------------------------------------------------------
# One project name per store on a machine (lowercase); it names the volume.
COMPOSE_PROJECT_NAME=storeops-store
# The store's code (letters/digits); also its folder in the R2 backup bucket.
STORE_CODE=
# Image to run (blank = build from this checkout as storeops:local).
STOREOPS_IMAGE=
# Where the store listens on the host (put a proxy or tunnel in front).
STORE_HTTP_BIND=127.0.0.1
STORE_HTTP_PORT=8000
# Set to the reverse proxy's address so client IPs / https are seen correctly.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Store basics ------------------------------------------------------------------------------
# IANA time zone of the store.
STORE_TIMEZONE=
# Public https address of this store (on the StoreOps domain), used in links
# the server sends out. Never a host under another product's domain.
PUBLIC_BASE_URL=
# Website origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=
# Leave blank (host-only cookie) unless the owner sets a StoreOps domain.
SESSION_COOKIE_DOMAIN=

# --- POS (Toast) -------------------------------------------------------------------------------
POS_PROVIDER=toast
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=

# --- Optional services (blank = off) -----------------------------------------------------------
ANTHROPIC_API_KEY=
WHAPI_API_TOKEN=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Path INSIDE the container, e.g. /data/firebase-service-account.json (chmod 600 in the volume).
FIREBASE_CREDENTIALS_FILE=

# --- Off-site backup: Litestream to Cloudflare R2 (profile "backup") ---------------------------
# Owner steps: backend/scripts/backup/README.md.
LITESTREAM_R2_ACCOUNT_ID=
LITESTREAM_R2_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

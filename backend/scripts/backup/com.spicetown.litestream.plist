<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE - not installed, and DISABLED until the owner's R2 keys exist
  (run_litestream.sh exits quietly without them). Continuous backup of the
  store database to Cloudflare R2. A LaunchDaemon (like the backend's own
  com.spicetown.backend) so it runs with nobody logged in, as the user who
  owns the database file (Litestream writes next to it: the -wal and a
  .spicetown.db-litestream folder). Install steps: scripts/backup/README.md.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spicetown.litestream</string>

    <key>UserName</key>
    <string>sundar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/sundar/spicetown-backend/backend/scripts/backup/run_litestream.sh</string>
    </array>

    <!-- HOME is not set for a LaunchDaemon; the wrapper finds its config
         and credentials under it. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/sundar</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash, but not after the wrapper's quiet "not set
         up yet" exit 0. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>Nice</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/sundar/spicetown-backend/backend/logs/litestream.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sundar/spicetown-backend/backend/logs/litestream.error.log</string>
</dict>
</plist>

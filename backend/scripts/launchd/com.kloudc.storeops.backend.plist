<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE - run one StoreOps store directly on a Mac (no Docker).
  Docker (repo-root Dockerfile + docker-compose.yml) is the default way to
  run a store; use this only for a bare-metal Mac install. Replace every
  __PLACEHOLDER__ first (see README.md next to this file), then install as a
  LaunchDaemon (system domain): it starts at boot with nobody logged in and
  restarts on a crash.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kloudc.storeops.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>__STOREOPS_DIR__/backend/.venv/bin/uvicorn</string>
        <string>app.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__STOREOPS_DIR__/backend</string>

    <!-- Runs as a normal user (not root) so it owns the SQLite file, uploads and .env. -->
    <key>UserName</key>
    <string>__RUN_AS_USER__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__STOREOPS_DIR__/backend/logs/backend.log</string>
    <key>StandardErrorPath</key>
    <string>__STOREOPS_DIR__/backend/logs/backend.error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin</string>
    </dict>
</dict>
</plist>

# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=sqlite:///./spicetown.db

# --- Toast API (Orders API + Purchasing & Receiving API) ---
# Standard API Access credentials from the Toast dev portal.
TOAST_API_BASE=https://ws-api.toasttab.com
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=

# --- Sales cron job ---
# Hour (0-23, in TOAST_TIMEZONE) the daily sales sync runs at.
SALES_SYNC_HOUR=4
SALES_SYNC_MINUTE=0
# IANA timezone the restaurant's "business date" is anchored to.
# Spice Town (Vernon, CT) is America/New_York, confirmed via
# GET /restaurants/v1/restaurants/{guid} -> general.timeZone.
TOAST_TIMEZONE=America/New_York
# Neutral name for the same setting (multi-store). Leave unset to use
# TOAST_TIMEZONE; when set, it wins.
# STORE_TIMEZONE=America/New_York
# How many trailing days the sync checks each run for gaps and backfills automatically
# (e.g. the service was down overnight for any reason).
SALES_SYNC_BACKFILL_DAYS=14
# Master switch for all scheduled jobs (sales sync, open-orders scans). Leave
# true in production; set false on a dev instance so it doesn't use the
# shared Toast API rate limit.
SCHEDULER_ENABLED=true

# --- CORS ---
# Comma-separated list of origins allowed to call this API. http://localhost:5173 is the React dev
# server; capacitor://localhost (iOS) and http://localhost (Android) are the mobile app's WebView
# origins - it bundles the built frontend locally but still calls this API cross-origin, so both
# need to stay here alongside the web origin(s).
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# --- Ask Inventory Bot (Claude API) ---
# From console.anthropic.com. Powers the natural-language query page - read-only,
# never used to write data. Without this set, that page returns a clear error
# telling you it's not configured; nothing else in the app depends on it.
ANTHROPIC_API_KEY=

# --- Invoice Submission (WhatsApp via Whapi + Toast email via Gmail) ---
# Replaces the old Google Form -> Sheet -> Apps Script workflow. Without
# these set, a submission still saves fine - it just records "not
# configured" for whichever send (WhatsApp/Toast email) is missing its
# credentials, visible in the UI with a Resend button once they're added.
#
# From your Whapi Cloud dashboard (whapi.cloud). WHAPI_CHAT_ID is the
# WhatsApp group's chat id (looks like "12036...@g.us") - Whapi's dashboard
# lists your connected chats/groups with their ids once the channel is set up.
WHAPI_API_TOKEN=
WHAPI_CHAT_ID=
# Only change this if Whapi's API base URL is ever different from the default.
WHAPI_BASE_URL=https://gate.whapi.cloud

# A Gmail address + an "app password" for it (NOT the real account password -
# generate one at myaccount.google.com/apppasswords; requires 2-Step
# Verification to be turned on for that Google account first).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Toast's invoicing inbox - an email here with a PDF attached automatically
# becomes a draft bill on Toast's side.
TOAST_INVOICE_EMAIL=spicetown@invoices.toasttab.com
# Neutral name for the same setting (multi-store): any accounts-payable
# inbox. Leave unset to use TOAST_INVOICE_EMAIL; set it blank to turn the
# invoice-inbox email off.
# AP_INBOX_EMAIL=spicetown@invoices.toasttab.com

# Public base URL used to build the "View Document" link sent over WhatsApp -
# must be reachable with no login, since WhatsApp group members don't have
# dashboard accounts. Only change this once the app moves off Tailscale to a
# real domain (see the spicetown skill file's mobile-app session note).
PUBLIC_BASE_URL=https://spicetown-server.tailcc1217.ts.net

# --- Push notifications (Firebase Cloud Messaging) ---
# Path to the Firebase service-account JSON (Firebase console -> Project
# settings -> Service accounts -> Generate new private key). Relative to the
# backend directory, or absolute. Leave blank until you have it: the app and
# the alert jobs still run, they just log what they would send.
FIREBASE_CREDENTIALS_FILE=
# Turns the alert jobs (their own scheduler, independent of SCHEDULER_ENABLED) on/off.
NOTIFICATIONS_ENABLED=true

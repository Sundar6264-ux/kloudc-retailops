{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://kloudc.com/retailops/help/schema.json",
 "title": "KloudC RetailOps help content",
 "description": "One object per file in content/help: manifest.json, pages.json, articles/*.json (as one array), getting-started.json, faq.json, troubleshooting.json, glossary.json, glossary-categories.json, contact.json. Text is plain with two inline marks: **bold** and links [text](page:<id>) / (article:<id>) / (term:<key>) / (https://...) / (mailto:...). Placeholders: {pos}, {store}, {store_city}, {support_email}. The server (backend/app/help_content.py) enforces this file with a small JSON Schema subset; the website and app tests check the cross-references.",
 "type": "object",
 "properties": {
  "manifest": {
   "type": "object",
   "required": ["version", "updated", "locale"],
   "additionalProperties": false,
   "properties": {
    "version": {"type": "integer"},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "locale": {"type": "string", "enum": ["en"]},
    "product": {"type": "string"},
    "hash": {"type": "string"}
   }
  },
  "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/PageEntry"}},
  "articles": {"type": "array", "items": {"$ref": "#/$defs/Article"}},
  "getting_started": {
   "type": "object",
   "additionalProperties": {"$ref": "#/$defs/Track"}
  },
  "faq": {"type": "array", "items": {"$ref": "#/$defs/Faq"}},
  "troubleshooting": {"type": "array", "items": {"$ref": "#/$defs/Trouble"}},
  "glossary": {"type": "array", "items": {"$ref": "#/$defs/ConceptTerm"}},
  "glossary_categories": {"type": "array", "items": {"$ref": "#/$defs/GlossaryCategory"}},
  "contact": {"$ref": "#/$defs/Contact"}
 },
 "$defs": {
  "Id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
  "ArticleId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
  "Area": {"anyOf": [{"type": "null"}, {"type": "string", "enum": ["home", "ordering", "stock", "sales", "team", "setup", "platform", "help"]}]},
  "Audience": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["owner", "admin", "staff", "master"]}},
  "Text": {"type": "string", "minLength": 1},
  "Info": {
   "type": "object",
   "required": ["summary", "points"],
   "additionalProperties": false,
   "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 200},
    "points": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "source": {"type": ["string", "null"]},
    "freshness": {"type": ["string", "null"]}
   }
  },
  "Section": {
   "type": "object",
   "required": ["title", "summary"],
   "additionalProperties": false,
   "properties": {
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 200},
    "points": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 160}}
   }
  },
  "PageEntry": {
   "type": "object",
   "required": ["id", "title", "area", "audience", "web", "app", "gating", "public", "info", "sections", "terms", "article", "new_until"],
   "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/Id"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "area": {"$ref": "#/$defs/Area"},
    "audience": {"$ref": "#/$defs/Audience"},
    "web": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["route"], "additionalProperties": false, "properties": {"route": {"type": "string", "pattern": "^/"}}}]},
    "app": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["location"], "additionalProperties": false, "properties": {"location": {"type": "string", "minLength": 1}}}]},
    "gating": {
     "type": "object",
     "required": ["feature", "admin", "salesOnly"],
     "additionalProperties": false,
     "properties": {
      "feature": {"type": ["string", "null"]},
      "admin": {"type": "boolean"},
      "salesOnly": {"type": "boolean"}
     }
    },
    "public": {"type": "boolean"},
    "info": {"$ref": "#/$defs/Info"},
    "sections": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Section"}},
    "terms": {"type": "array", "items": {"$ref": "#/$defs/Id"}},
    "article": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ArticleId"}]},
    "new_until": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}]}
   }
  },
  "Block": {
   "type": "object",
   "required": ["type"],
   "additionalProperties": false,
   "properties": {
    "type": {"type": "string", "enum": ["h", "p", "steps", "bullets", "tip", "note", "warning", "example"]},
    "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "text": {"type": "string", "minLength": 1},
    "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
   }
  },
  "Blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Block"}},
  "Article": {
   "type": "object",
   "required": ["id", "title", "area", "group", "audience", "summary", "pages", "related", "blocks"],
   "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/ArticleId"},
    "title": {"type": "string", "minLength": 1},
    "area": {"$ref": "#/$defs/Area"},
    "group": {"type": "string", "enum": ["basics", "home", "ordering", "stock", "sales", "team", "setup", "account", "master"]},
    "order": {"type": "integer"},
    "audience": {"$ref": "#/$defs/Audience"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/Id"}},
    "related": {"type": "array", "items": {"$ref": "#/$defs/ArticleId"}},
    "blocks": {"$ref": "#/$defs/Blocks"}
   }
  },
  "Track": {
   "type": "object",
   "required": ["title", "intro", "audience", "steps"],
   "additionalProperties": false,
   "properties": {
    "title": {"type": "string", "minLength": 1},
    "intro": {"type": "string", "minLength": 1},
    "audience": {"$ref": "#/$defs/Audience"},
    "steps": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": ["title", "text", "page", "article"],
      "additionalProperties": false,
      "properties": {
       "title": {"type": "string", "minLength": 1},
       "text": {"type": "string", "minLength": 1},
       "page": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/Id"}]},
       "article": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ArticleId"}]}
      }
     }
    }
   }
  },
  "Faq": {
   "type": "object",
   "required": ["id", "q", "a", "area", "audience", "pages"],
   "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/ArticleId"},
    "q": {"type": "string", "minLength": 1},
    "a": {"$ref": "#/$defs/Blocks"},
    "area": {"$ref": "#/$defs/Area"},
    "audience": {"$ref": "#/$defs/Audience"},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/Id"}}
   }
  },
  "Trouble": {
   "type": "object",
   "required": ["id", "symptom", "causes", "fixes", "area", "audience", "pages"],
   "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/ArticleId"},
    "symptom": {"type": "string", "minLength": 1},
    "causes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "fixes": {"$ref": "#/$defs/Blocks"},
    "area": {"$ref": "#/$defs/Area"},
    "audience": {"$ref": "#/$defs/Audience"},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/Id"}}
   }
  },
  "ConceptTerm": {
   "type": "object",
   "required": ["key", "label", "category", "area", "definition", "aliases", "where", "pages", "related"],
   "additionalProperties": false,
   "properties": {
    "key": {"type": "string", "pattern": "^concept_[a-z0-9_]+$"},
    "label": {"type": "string", "minLength": 1},
    "category": {"type": "string", "pattern": "^concept_[a-z_]+$"},
    "area": {"$ref": "#/$defs/Area"},
    "definition": {"type": "string", "minLength": 1, "maxLength": 240},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "where": {"type": "string"},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/Id"}},
    "related": {"type": "array", "items": {"$ref": "#/$defs/Id"}}
   }
  },
  "GlossaryCategory": {
   "type": "object",
   "required": ["key", "label", "area", "where"],
   "additionalProperties": false,
   "properties": {
    "key": {"type": "string", "pattern": "^concept_[a-z_]+$"},
    "label": {"type": "string", "minLength": 1},
    "area": {"$ref": "#/$defs/Area"},
    "where": {"type": "string"}
   }
  },
  "Contact": {
   "type": "object",
   "required": ["email", "support_url", "contact_url", "privacy_url", "terms_url", "company", "location"],
   "additionalProperties": false,
   "properties": {
    "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"},
    "support_url": {"type": "string", "pattern": "^https://"},
    "contact_url": {"type": "string", "pattern": "^https://"},
    "privacy_url": {"type": "string", "pattern": "^https://"},
    "terms_url": {"type": "string"},
    "website_url": {"type": "string", "pattern": "^https://"},
    "company": {"type": "string"},
    "location": {"type": "string"},
    "product": {"type": "string"},
    "intro": {"type": "string"},
    "tips": {"type": "array", "items": {"type": "string"}}
   }
  }
 }
}

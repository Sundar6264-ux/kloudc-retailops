# Shared-service settings for docker-compose.platform.yml on a cloud VM.
#   cp deploy/cloud-vm/env.platform.example .env.platform && chmod 600 .env.platform
# Never commit .env.platform. Secrets are blank here.
APP_ENV=production
POSTGRES_PASSWORD=
# python -m app.platform gen-key (keep an OFFLINE copy)
RETAILOPS_SECRET_KEYS=
PLATFORM_DOMAIN=kloudc.com
PLATFORM_PUBLIC_URL=https://app.kloudc.com
CORS_ORIGINS=https://app.kloudc.com
# Caddy (profile "https") serves this host name.
PLATFORM_HOST=app.kloudc.com
SESSION_COOKIE_SECURE=true
# Caddy is the only proxy in front of the app (keep PLATFORM_HTTP_BIND=127.0.0.1).
FORWARDED_ALLOW_IPS=*
SIGNUP_ENABLED=false
PLATFORM_REQUIRE_TOTP=
LOG_FORMAT=json
LOG_DIR=/data/logs
FIREBASE_CREDENTIALS_FILE=
# Backup job (profile "backup"): daily at this UTC time.
BACKUP_AT=07:15
BACKUP_KEEP_DAYS=30

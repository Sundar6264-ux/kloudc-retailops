<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE: nightly made-up data refresh of the App Review DEMO store (does nothing until demo-provision has made it). -->
<plist version="1.0">
<dict>
    <key>Label</key><string>__LABEL_PREFIX__.demo</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ROOT__/app/deploy/pilot-mac/run-demo-reset.sh</string>
    </array>
    <key>WorkingDirectory</key><string>__ROOT__/app/backend</string>
    <key>UserName</key><string>__USER__</string>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>__DEMO_HOUR__</integer><key>Minute</key><integer>__DEMO_MINUTE__</integer></dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key><string>__HOME__</string>
        <key>PILOT_ROOT</key><string>__ROOT__</string>
    </dict>
    <key>StandardOutPath</key><string>__ROOT__/logs/demo.log</string>
    <key>StandardErrorPath</key><string>__ROOT__/logs/demo.log</string>
</dict>
</plist>

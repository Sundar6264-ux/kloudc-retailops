<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE: the KloudC RetailOps Cloudflare Tunnel 'kloudc-retailops'
     (app.kloudc.com to 127.0.0.1:__APP_PORT__). install-tunnel.sh renders it.
     Its OWN cloudflared process, label and files: it never uses the default
     cloudflared config or cert.pem of the user, and is never installed with
     the cloudflared "service install" command, so another tunnel on this Mac
     keeps its own service untouched. The arguments placeholder becomes a token
     run (dashboard-managed tunnel, the default: secrets/tunnel.token and an
     own nearly empty config/tunnel-token.yml) or a named run with
     config/tunnel.yml (locally managed, from tunnel/config.yml.template). -->
<plist version="1.0">
<dict>
    <key>Label</key><string>__LABEL_PREFIX__.tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>__CLOUDFLARED__</string>
__TUNNEL_ARGS__
    </array>
    <key>WorkingDirectory</key><string>__ROOT__</string>
    <key>UserName</key><string>__USER__</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>15</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key><string>__ROOT__/run/tunnel-home</string>
    </dict>
    <key>StandardOutPath</key><string>__ROOT__/logs/tunnel.out.log</string>
    <key>StandardErrorPath</key><string>__ROOT__/logs/tunnel.err.log</string>
</dict>
</plist>

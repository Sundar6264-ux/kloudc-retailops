<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE (NOT installed by default): a background job worker
     (python -m app.jobqueue worker) for JOB_QUEUE_MODE=queue. Installed only
     with "sudo install.sh" and its worker option, after the owner turns the queue on
     (docs/DEPLOY_MULTI_PROCESS.md). -->
<plist version="1.0">
<dict>
    <key>Label</key><string>__LABEL_PREFIX__.worker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ROOT__/app/deploy/pilot-mac/start-worker.sh</string>
    </array>
    <key>WorkingDirectory</key><string>__ROOT__/app/backend</string>
    <key>UserName</key><string>__USER__</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <!-- SIGTERM: running jobs get 25 s to finish, the rest go back to the queue. -->
    <key>ExitTimeOut</key><integer>40</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key><string>__HOME__</string>
        <key>PILOT_ROOT</key><string>__ROOT__</string>
    </dict>
    <key>StandardOutPath</key><string>__ROOT__/logs/worker.out.log</string>
    <key>StandardErrorPath</key><string>__ROOT__/logs/worker.err.log</string>
</dict>
</plist>


# KloudC RetailOps - production settings for app.kloudc.com (pre-production
# 2026-10-21; docs/GO_LIVE_RUNBOOK.md step C3). Nothing reads this file
# itself: APPEND it to <install>/config/pilot.env (that file is loaded by
# bash, so these later lines win over the same names above them), then
# restart with update.sh:
#   cat <install>/app/deploy/pilot-mac/production.env.example >> <install>/config/pilot.env
# No secrets here - secrets stay in <install>/secrets/. `retailops.sh ops
# check-config` lists anything still missing.

# The public address (Cloudflare Tunnel 'kloudc-retailops' -> 127.0.0.1:8900).
PLATFORM_PUBLIC_URL='https://app.kloudc.com'
PLATFORM_DOMAIN='kloudc.com'
# Every store's links (WhatsApp file links, checklist and invoice links,
# logos in emails). Blank would mean https://<store>.kloudc.com, which the
# tunnel does not serve. (PUBLIC_BASE_URL is a per-store setting on the
# shared service; leave it unset here.)
PUBLIC_HOST='https://app.kloudc.com'
# The website on app.kloudc.com, plus the address already set above it in
# pilot.env (the Tailscale address), while both are used.
CORS_ORIGINS="https://app.kloudc.com${CORS_ORIGINS:+,$CORS_ORIGINS}"

# Login cookie: https only, host-only on app.kloudc.com (blank domain).
SESSION_COOKIE_SECURE='true'
SESSION_COOKIE_DOMAIN=''

# The visitor's address for login lockouts and rate limits. The server
# trusts this header ONLY from FORWARDED_ALLOW_IPS (cloudflared and Tailscale
# connect from 127.0.0.1) - app/platform/client_ip.py.
DIRECTORY_CLIENT_IP_HEADER='CF-Connecting-IP'
FORWARDED_ALLOW_IPS='127.0.0.1'

# Masters (platform accounts) must use two-step sign-in.
PLATFORM_REQUIRE_TOTP='true'
# Sign-ups: closed until the owner opens them. When open, every sign-up waits
# for a master's approval (there is no auto-approve).
SIGNUP_ENABLED='false'

# Legal links shown at sign-in and in About.
TERMS_URL='https://app.kloudc.com/terms'
# PRIVACY_URL / SUPPORT_URL keep their kloudc.com defaults.

# Universal links (app opens from https://app.kloudc.com links): the KloudC
# LLC Apple team ID, once the Apple Developer enrolment is done (runbook G):
# APPLE_TEAM_ID='<Team ID>'

# Push notifications: the KloudC RetailOps Firebase service account (a file
# path under <install>/secrets/), once the Firebase project exists:
# FIREBASE_CREDENTIALS_FILE='<install>/secrets/<the service account file>.json'

# Security headers (CSP, frames, HSTS). Keep enforce.
SECURITY_HEADERS='enforce'

# Off-site backup: an encrypted copy of each nightly backup goes here
# (iCloud Drive; any synced folder or mounted disk works). The key is created
# at <install>/secrets/offsite-backup.key on the first run - keep a copy of
# it in a password manager.
BACKUP_OFFSITE_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/KloudC RetailOps backups"
BACKUP_OFFSITE_KEEP='14'

# StoreOps DEMO store settings (copy to demo.env / the DEMO checkout's backend/.env).
# Made-up store; no secrets belong here. run_demo.py forces the DEMO-only
# values (STORE_CODE=DEMO, POS_PROVIDER=csv, DEMO_MODE=true, data paths) and
# blanks every outside credential, so a value set here for those is ignored.

# --- identity and branding (contract section 7, DEMO column) ---
STORE_NAME=StoreOps Demo Market
STORE_SHORT_NAME=Demo
STORE_ADDRESS=300 Demo Rd, Hartford, CT 06101
STORE_PHONE=(555) 010-0300
STORE_TIMEZONE=America/New_York
BRAND_COLOR=#0F766E
BRAND_SECONDARY_COLOR=#334155
PRODUCT_NAME=StoreOps
COMPANY_NAME=KloudC LLC
# Owner: the real platform domain once chosen (contract 9.1). Servers refuse a host of the old single-store domain.
PLATFORM_DOMAIN=storeops.invalid
PUBLIC_HOST=
PUBLIC_BASE_URL=

# --- legal (owner fills TERMS_URL when a terms page exists) ---
PRIVACY_URL=https://kloudc.com/kloudc-privacy-policy/
TERMS_URL=
SUPPORT_URL=https://kloudc.com/kloudc-support/
# Blank = the built-in notice (app/legal.py). AI stays off in the DEMO store.
AI_CONSENT_NOTICE=

# --- the App Review login ---
# Username: appreview (made by the generator). Password: set it here
# (at least 10 characters) or leave blank and the runner creates one in
# <data-dir>/review_password (mode 600) and keeps it across resets.
DEMO_REVIEW_PASSWORD=
DEMO_USERNAMES=appreview

# --- app release ---
APP_BUNDLE_ID=com.kloudc.storeops
MIN_SUPPORTED_BUILD_IOS=0
MIN_SUPPORTED_BUILD_ANDROID=0
APP_STORE_URL=
PLAY_STORE_URL=

# --- background work ---
SCHEDULER_ENABLED=true
NOTIFICATIONS_ENABLED=false
TEAM_JOBS_ENABLED=true

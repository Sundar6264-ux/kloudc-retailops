# Used only by `npm run build:mobile` (Capacitor). Unlike the web build -
# which is served BY this same backend, so a relative "" API base correctly
# resolves same-origin - the mobile app's WebView loads from its own local
# origin (capacitor://localhost on iOS, http://localhost on Android), so it
# needs the real, absolute API URL baked in at build time instead.
#
# When the domain migration off Tailscale happens, this is the one line to
# update before the next mobile build/release - nothing else in the app
# hardcodes this URL.
VITE_API_BASE=https://ops.spicetown.shop

# Used only by `npm run build:mobile` (the Capacitor wrapper). Unlike the web
# build - which is served BY the store's own backend, so a relative "" API
# base resolves same-origin - the wrapper's WebView loads from a local origin
# (capacitor://localhost on iOS, http://localhost on Android), so it needs an
# absolute API URL baked in at build time.
#
# Placeholder: set this to the store's own host on the StoreOps domain
# (PLATFORM_DOMAIN) before a mobile build. Never a host under another
# product's domain. The Flutter app (storeops-app) is the supported mobile
# client; this wrapper is kept only for builds that still need it.
VITE_API_BASE=https://demo.storeops.invalid

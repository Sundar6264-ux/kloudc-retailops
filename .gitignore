# KloudC RetailOps repository-wide guards (secrets and store data never go in git).
.env
.env.*
!.env.example
!frontend/.env.mobile
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.p12
*.p8
*.pem
*.key
*.mobileprovision
GoogleService-Info.plist
google-services.json
firebase-service-account*.json
# node_modules may be a symlink in local checkouts (a "dir/" pattern misses symlinks).
node_modules
# Store catalog exports used by the similar-products eval are a store's own data.
backend/tests/data/similar_products_catalog.tsv
backend/tests/data/similar_products_labels.json
.DS_Store

# Store packs and settings of real stores never go in git (docs/M2_CONTRACT.md 1.6):
# a private folder outside git, or this ignored one. Only product and fake
# packs (backend/packs/*.json) and fake-store fixtures are committed.
backend/packs/private/
**/*.pack.json
**/legacy_cases.json
**/forbidden_tokens.txt

# Dev master key ring (platform contract 8.4) and other local secrets.
backend/.secrets/
